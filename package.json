{
  "name": "skincare-store-dashly-studio",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:cms": "pnpm --filter cms dev",
    "check": "biome check . && prettier --check --no-error-on-unmatched-pattern \"**/*.{scss,css}\"",
    "fix": "biome check --write . && prettier --write --no-error-on-unmatched-pattern \"**/*.{scss,css}\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "lefthook": "^2.1.12",
    "prettier": "3.9.6"
  }
}
